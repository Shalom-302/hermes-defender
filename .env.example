# Copier en .env (gitignoré) et remplir. NE JAMAIS committer .env.

# ---- Hermes (modèle) ----
ANTHROPIC_API_KEY=sk-ant-...
# ou autre provider configuré dans Hermes

# ---- WhatsApp via gowhatsappwebmultidevice (API directe) ----
# Conteneur réel sur le VPS : shalom-gowa, port interne 3080, sur whatsapp-shared-network.
GOWA_URL=http://shalom-gowa:3080
GOWA_BASIC_USER=shalomtehe
# ⚠️ Ce mot de passe a fuité en clair — CHANGE-LE côté gowa puis mets le nouveau ici.
GOWA_BASIC_PASS=change-me-apres-rotation

# Destinataire des alertes = TON numéro WhatsApp (celui qui doit recevoir les messages).
# +2250712116258 -> on retire le + : 2250712116258@s.whatsapp.net
WA_RECIPIENT=2250712116258@s.whatsapp.net

# ---- Divers ----
VPS_NAME=vmi3096991
HERMES_UID=10000
HERMES_GID=10000
